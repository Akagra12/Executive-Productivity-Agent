# Environment Variables — AIONOS Executive Productivity Agent
# Copy this file to .env and fill in real values.
# NEVER commit your real .env file to git.

# ── Server ──────────────────────────────────────────────────────────────────
# Port the Express server will listen on. Default is 3001 if not set.
PORT=3001

# ── LLM API ─────────────────────────────────────────────────────────────────
# Add your Gemini API key here (get one free from https://aistudio.google.com)
# OR your OpenAI key — we will decide which to use before implementing the agent.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Application ─────────────────────────────────────────────────────────────
# Context date for the demo (the "today" the agent reasons against)
# Format: YYYY-MM-DD  |  Set to 2026-09-23 for the most interesting demo day
DEMO_DATE=2026-09-23
